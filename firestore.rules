rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function validBookingForSlot(slotId) {
      return signedIn()
        && request.resource.data.status == "full"
        && request.resource.data.bookingId is string
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotId == slotId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.bigoId is string;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /slots/{slotId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (resource.data.status == "available" && validBookingForSlot(slotId));
    }
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.bigoId is string
        && request.resource.data.bigoId.size() >= 3
        && request.resource.data.bigoId.size() <= 40
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.slotId is string
        && request.resource.data.lookupCode is string
        && request.resource.data.status in ["Reserved", "Pending approval", "Approved", "Opponent assigned"]
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.bookingId == bookingId
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.status == "full");
      allow update, delete: if isAdmin();
    }
    match /publicBookings/{lookupCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.lookupCode == lookupCode
        && request.resource.data.bookingId is string
        && request.resource.data.bigoId is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.lookupCode == lookupCode;
      allow update, delete: if isAdmin();
    }
    match /publicBigoLookup/{bigoId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.bigoId == bigoId
        && request.resource.data.bookingId is string
        && request.resource.data.lookupCode is string
        && request.resource.data.lookupCodes is list
        && request.resource.data.lookupCodes.size() == 1
        && request.resource.data.lookupCodes.hasAny([request.resource.data.lookupCode])
        && getAfter(/databases/$(database)/documents/publicBookings/$(request.resource.data.lookupCode)).data.bigoId == bigoId);
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.bigoId == bigoId
        && request.resource.data.bookingId is string
        && request.resource.data.lookupCode is string
        && request.resource.data.lookupCodes is list
        && getAfter(/databases/$(database)/documents/publicBookings/$(request.resource.data.lookupCode)).data.bigoId == bigoId
        && (
          (resource.data.lookupCodes is list
            && request.resource.data.lookupCodes.size() == resource.data.lookupCodes.size() + 1
            && request.resource.data.lookupCodes.hasAll(resource.data.lookupCodes))
          || (!(resource.data.lookupCodes is list)
            && resource.data.lookupCode is string
            && request.resource.data.lookupCodes.size() == 2
            && request.resource.data.lookupCodes.hasAny([resource.data.lookupCode]))
        ));
      allow delete: if isAdmin();
    }
  }
}
